{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pygpui.local/harness/schemas/gate-results.schema.json",
  "title": "pygpui Phase 1 gate result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate_id",
    "task_id",
    "stage",
    "status",
    "evidence",
    "source_commit",
    "lockfile_sha256",
    "toolchain",
    "reviewer_session_id",
    "tester_session_id",
    "aggregator"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "gate_id": {"type": "string", "pattern": "^AR[0-9]{2}-G[0-9]+(\\.[a-z0-9-]+)?$"},
    "task_id": {"type": "string", "pattern": "^P1-[A-Z0-9-]+$"},
    "stage": {"type": "string", "minLength": 1},
    "status": {"enum": ["pass", "fail", "inconclusive", "blocked", "not_measured"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "artifact_id": {"type": "string"},
          "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
        }
      }
    },
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "lockfile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "toolchain": {"type": "string", "minLength": 1},
    "reviewer_session_id": {"type": "string", "minLength": 1},
    "tester_session_id": {"type": "string", "minLength": 1},
    "integrator_session_id": {"type": "string"},
    "aggregator": {"type": "boolean"},
    "depends_on_sub_gates": {
      "type": "array",
      "items": {"type": "string", "pattern": "^AR[0-9]{2}-G[0-9]+\\.[a-z0-9-]+$"},
      "uniqueItems": true
    }
  }
}
